{
  "name": "gamedeck",
  "version": "1.2.0",
  "description": "A cinematic, local-first launcher for legally owned game libraries on Windows, macOS, and Linux.",
  "main": "main.js",
  "author": {
    "name": "B11 Health",
    "email": "184023492+B11-Health@users.noreply.github.com",
    "url": "https://github.com/B11-Health"
  },
  "desktopName": "gamedeck.desktop",
  "license": "MIT",
  "homepage": "https://b11-health.github.io/gamedeck/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/B11-Health/gamedeck.git"
  },
  "bugs": {
    "url": "https://github.com/B11-Health/gamedeck/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "check": "node scripts/repo-audit.mjs && node --check play-session-manager.js && node --check play-session-capture-grant.js && node --check play-session-process-policy.js && node --check play-session-input-protocol.js && node --check main.js && node --check preload.js && node --check stream-server.js && node --check netplay-manager.js && node --check src/app.js && node --check src/streaming.js && node --check src/netplay.js && node --check mobile/web/app.js && node --check mobile/web/sw.js && node scripts/play-session-manager.test.mjs && node scripts/play-session-capture-grant.test.mjs && node scripts/play-session-process-policy.test.mjs && node scripts/play-session-input-protocol.test.mjs && node scripts/runtime-cache-stream-limit.test.mjs && node scripts/smoke-test.mjs",
    "test": "npm run check",
    "pack": "npm run runtime:cache && electron-builder --dir",
    "dist": "npm run runtime:cache && electron-builder --publish never",
    "dist:win": "npm run runtime:cache -- --platform=win32-x64 && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run runtime:cache -- --platform=darwin-universal && electron-builder --mac --universal --publish never",
    "dist:linux": "npm run runtime:cache -- --platform=linux-x64 && electron-builder --linux --x64 --publish never",
    "wallet:create": "node scripts/create-donation-wallet.mjs",
    "runtime:cache": "node scripts/prepare-runtime-cache.mjs",
    "video:youtube": "node scripts/generate-youtube-video.cjs",
    "video:capture-motion": "node scripts/capture-social-trailer.cjs",
    "video:render-motion": "node scripts/render-social-launch.cjs",
    "video:motion": "npm run video:capture-motion && npm run video:render-motion",
    "video:short": "node scripts/generate-social-short.cjs",
    "video:campaign": "node scripts/generate-social-campaign.cjs",
    "audit:repo": "node scripts/repo-audit.mjs"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "26.15.3",
    "ethers": "6.17.0",
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "io.gamedeck.launcher",
    "productName": "GameDeck",
    "copyright": "Copyright © 2026 B11 Health and GameDeck contributors",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "play-session-manager.js",
      "play-session-input-protocol.js",
      "play-session-process-policy.js",
      "play-session-capture-grant.js",
      "runtime-manager.js",
      "stream-server.js",
      "netplay-manager.js",
      "src/**/*",
      "assets/**/*",
      "!assets/branding/brand-kit/**/*",
      "config/**/*",
      "sponsors.json",
      "LICENSE",
      "!**/*.map",
      "!screenshots/**/*",
      "!backups/**/*",
      "mobile/web/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "GameDeck",
      "runAfterFinish": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "GameDeck can include game audio when you start a local GameDeck Live stream.",
        "NSLocalNetworkUsageDescription": "GameDeck shares gameplay directly with your paired devices on the local network."
      },
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/node_modules/7zip-bin/**"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Game",
      "maintainer": "B11 Health <184023492+B11-Health@users.noreply.github.com>",
      "syncDesktopName": true,
      "synopsis": "Local-first game library launcher",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "B11-Health",
      "repo": "gamedeck",
      "releaseType": "release"
    },
    "asarUnpack": [
      "node_modules/7zip-bin/**/*"
    ],
    "extraResources": [
      {
        "from": "build/runtime-cache",
        "to": "runtime-cache",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "7zip-bin": "^5.2.0"
  }
}
