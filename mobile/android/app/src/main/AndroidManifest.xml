<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
  <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
  <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <uses-permission android:name="android.permission.REORDER_TASKS" />

  <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
  <uses-feature android:name="android.hardware.gamepad" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

  <queries>
    <package android:name="com.retroarch" />
    <package android:name="com.retroarch.aarch64" />
    <package android:name="com.retroarch.ra32" />
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <category android:name="android.intent.category.DEFAULT" />
      <data android:scheme="content" />
    </intent>
  </queries>

  <application
      android:name="io.gamedeck.mobile.GameDeckApplication"
      android:allowBackup="true"
      android:appCategory="game"
      android:enableOnBackInvokedCallback="false"
      android:hardwareAccelerated="true"
      android:icon="@drawable/gamedeck_icon"
      android:roundIcon="@drawable/gamedeck_icon"
      android:label="${appLabel}"
      android:largeHeap="true"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="true">

    <provider
        android:name="io.gamedeck.mobile.ManagedLibraryProvider"
        android:authorities="${applicationId}.managed"
        android:exported="false"
        android:grantUriPermissions="true"
        android:enabled="${fullDeckEnabled}" />

    <activity
        android:name="io.gamedeck.mobile.GameDeckPs2BootstrapActivity"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:enabled="${fullDeckEnabled}"
        android:excludeFromRecents="true"
        android:exported="false"
        android:hardwareAccelerated="true"
        android:launchMode="singleTop"
        android:process=":ps2"
        android:screenOrientation="fullSensor"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />

    <activity
        android:name="io.gamedeck.mobile.GameDeckPlayActivity"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:enabled="${fullDeckEnabled}"
        android:exported="false"
        android:hardwareAccelerated="true"
        android:launchMode="singleTop"
        android:process=":gameplay"
        android:screenOrientation="fullSensor"
        android:theme="@style/AppTheme" />

    <activity
        android:name="io.gamedeck.mobile.MainActivity"
        android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:enabled="${fullDeckEnabled}"
        android:exported="true"
        android:launchMode="singleTask"
        android:screenOrientation="fullSensor">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="gamedeck" android:host="connect" android:pathPrefix="/qa-e2e" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="gamedeck" android:host="play" android:pathPrefix="/nba-street-vol2" />
      </intent-filter>
    </activity>

    <activity
        android:name="io.gamedeck.mobile.ControllerActivity"
        android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|uiMode"
        android:enabled="${controllerEnabled}"
        android:exported="true"
        android:label="GameDeck Controller"
        android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <data android:scheme="gamedeck" android:host="connect" />
      </intent-filter>
    </activity>

    <activity-alias
        android:name="io.gamedeck.mobile.ControllerLauncher"
        android:targetActivity="io.gamedeck.mobile.ControllerActivity"
        android:enabled="${controllerLauncherEnabled}"
        android:exported="true"
        android:icon="@mipmap/ic_launcher"
        android:label="GameDeck Controller">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>
  </application>
</manifest>
